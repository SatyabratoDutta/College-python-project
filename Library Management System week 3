# Library Management System

books = {
    101: {"title": "Python Programming", "author": "John Smith", "status": "Available"},
    102: {"title": "Data Structures", "author": "Mark Allen", "status": "Available"},
    103: {"title": "Database Management", "author": "James Brown", "status": "Available"},
    104: {"title": "Java Programming", "author": "Robert Martin", "status": "Available"}
}

issued_books = {}


def display_books():
    print("\n--- Book List ---")
    for book_id, book in books.items():
        print(f"ID: {book_id} | Title: {book['title']} | "
              f"Author: {book['author']} | Status: {book['status']}")


def add_book():
    try:
        book_id = int(input("Enter Book ID: "))

        if book_id in books:
            print("Book ID already exists.")
            return

        title = input("Enter Book Title: ")
        author = input("Enter Author Name: ")

        books[book_id] = {
            "title": title,
            "author": author,
            "status": "Available"
        }

        print("Book added successfully.")

    except ValueError:
        print("Invalid Book ID.")


def issue_book():
    try:
        book_id = int(input("Enter Book ID: "))

        if book_id not in books:
            print("Book not found.")
            return

        if books[book_id]["status"] == "Issued":
            print("Book is already issued.")
            return

        name = input("Enter student name: ")

        issued_books[book_id] = name
        books[book_id]["status"] = "Issued"

        print("Book issued successfully.")

    except ValueError:
        print("Invalid Book ID.")


def return_book():
    try:
        book_id = int(input("Enter Book ID: "))

        if book_id not in books:
            print("Book not found.")
            return

        if books[book_id]["status"] == "Available":
            print("Book is already available.")
            return

        del issued_books[book_id]
        books[book_id]["status"] = "Available"

        print("Book returned successfully.")

    except ValueError:
        print("Invalid Book ID.")


def search_book():
    keyword = input("Enter book title or author: ").lower()

    found = False

    for book_id, book in books.items():
        if keyword in book["title"].lower() or keyword in book["author"].lower():
            print(f"\nID: {book_id}")
            print(f"Title: {book['title']}")
            print(f"Author: {book['author']}")
            print(f"Status: {book['status']}")
            found = True

    if not found:
        print("Book not found.")


def delete_book():
    try:
        book_id = int(input("Enter Book ID: "))

        if book_id not in books:
            print("Book not found.")
            return

        if books[book_id]["status"] == "Issued":
            print("Cannot delete an issued book.")
            return

        del books[book_id]

        print("Book deleted successfully.")

    except ValueError:
        print("Invalid Book ID.")


while True:
    print("\n==============================")
    print("    LIBRARY MANAGEMENT SYSTEM")
    print("==============================")
    print("1. Display All Books")
    print("2. Add Book")
    print("3. Issue Book")
    print("4. Return Book")
    print("5. Search Book")
    print("6. Delete Book")
    print("7. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        display_books()

    elif choice == "2":
        add_book()

    elif choice == "3":
        issue_book()

    elif choice == "4":
        return_book()

    elif choice == "5":
        search_book()

    elif choice == "6":
        delete_book()

    elif choice == "7":
        print("Thank you for using Library Management System!")
        break

    else:
        print("Invalid choice. Please try again.")
