#Write a Python program to find the first character in a given string that appears only 
#once. 
#The program should: 
#● Count the frequency of each character in the string. 
#● Check the characters from left to right. 
#● Display the first character whose frequency is exactly 1. 
#● If every character appears more than once, display -1.




text = "leetcode"

frequency = {}

# Count frequency of each character
for char in text:
    frequency[char] = frequency.get(char, 0) + 1

# Find first character appearing only once
result = -1

for char in text:
    if frequency[char] == 1:
        result = char
        break

print(result)




