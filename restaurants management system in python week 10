import json
import os

MENU_FILE = "menu.json"
ORDER_FILE = "orders.json"


def load_data(filename):
    if os.path.exists(filename):
        try:
            with open(filename, "r") as file:
                return json.load(file)
        except (json.JSONDecodeError, FileNotFoundError):
            return {}
    return {}


def save_data(filename, data):
    with open(filename, "w") as file:
        json.dump(data, file, indent=4)


menu = load_data(MENU_FILE)
orders = load_data(ORDER_FILE)


# ================= ADD FOOD =================

def add_food():
    food_id = input("Enter Food ID: ").strip()

    if food_id in menu:
        print("Food item already exists!")
        return

    name = input("Enter Food Name: ").strip()

    try:
        price = float(input("Enter Food Price: "))
    except ValueError:
        print("Invalid price!")
        return

    if price <= 0:
        print("Price must be greater than 0!")
        return

    category = input("Enter Category: ").strip()

    menu[food_id] = {
        "name": name,
        "price": price,
        "category": category
    }

    save_data(MENU_FILE, menu)

    print("Food item added successfully!")


# ================= VIEW MENU =================

def view_menu():
    if not menu:
        print("Menu is empty!")
        return

    print("\n============== RESTAURANT MENU ==============")

    for food_id, item in menu.items():
        print(
            f"ID: {food_id} | "
            f"Name: {item['name']} | "
            f"Category: {item['category']} | "
            f"Price: ₹{item['price']:.2f}"
        )


# ================= SEARCH FOOD =================

def search_food():
    search = input("Enter food name to search: ").lower().strip()

    found = False

    for food_id, item in menu.items():
        if search in item["name"].lower():
            print(
                f"ID: {food_id} | "
                f"{item['name']} | "
                f"₹{item['price']:.2f} | "
                f"{item['category']}"
            )
            found = True

    if not found:
        print("Food item not found!")


# ================= TAKE ORDER =================

def take_order():
    if not menu:
        print("Menu is empty!")
        return

    customer = input("Enter Customer Name: ").strip()
    table = input("Enter Table Number: ").strip()

    order_items = []
    total = 0

    while True:
        view_menu()

        food_id = input(
            "\nEnter Food ID (or type 'done' to finish): "
        ).strip()

        if food_id.lower() == "done":
            break

        if food_id not in menu:
            print("Invalid Food ID!")
            continue

        try:
            quantity = int(input("Enter Quantity: "))
        except ValueError:
            print("Invalid quantity!")
            continue

        if quantity <= 0:
            print("Quantity must be greater than 0!")
            continue

        item = menu[food_id]

        amount = item["price"] * quantity
        total += amount

        order_items.append({
            "food_id": food_id,
            "name": item["name"],
            "price": item["price"],
            "quantity": quantity,
            "amount": amount
        })

        print(f"{item['name']} added to order.")

    if not order_items:
        print("No items ordered!")
        return

    # Generate unique Order ID
    if orders:
        order_id = str(max(int(i) for i in orders.keys()) + 1)
    else:
        order_id = "1"

    orders[order_id] = {
        "customer": customer,
        "table": table,
        "items": order_items,
        "total": total
    }

    save_data(ORDER_FILE, orders)

    print("\n========== ORDER CONFIRMED ==========")
    print("Order ID :", order_id)
    print("Customer :", customer)
    print("Table    :", table)
    print(f"Total    : ₹{total:.2f}")


# ================= GENERATE BILL =================

def generate_bill():
    order_id = input("Enter Order ID: ").strip()

    if order_id not in orders:
        print("Order not found!")
        return

    order = orders[order_id]

    print("\n")
    print("============================================")
    print("              RESTAURANT BILL")
    print("============================================")
    print("Order ID :", order_id)
    print("Customer :", order["customer"])
    print("Table    :", order["table"])
    print("--------------------------------------------")

    print(
        f"{'Food':20}"
        f"{'Qty':5}"
        f"{'Price':10}"
        f"{'Amount':10}"
    )

    print("--------------------------------------------")

    for item in order["items"]:
        print(
            f"{item['name'][:20]:20}"
            f"{item['quantity']:<5}"
            f"₹{item['price']:<9.2f}"
            f"₹{item['amount']:<9.2f}"
        )

    subtotal = order["total"]

    gst = subtotal * 0.05
    grand_total = subtotal + gst

    print("--------------------------------------------")
    print(f"Subtotal                 : ₹{subtotal:.2f}")
    print(f"GST (5%)                 : ₹{gst:.2f}")
    print("--------------------------------------------")
    print(f"GRAND TOTAL              : ₹{grand_total:.2f}")
    print("============================================")
    print("        THANK YOU! VISIT AGAIN")
    print("============================================")


# ================= VIEW ORDERS =================

def view_orders():
    if not orders:
        print("No orders available!")
        return

    print("\n============== ALL ORDERS ==============")

    for order_id, order in orders.items():

        print(f"\nOrder ID : {order_id}")
        print(f"Customer : {order['customer']}")
        print(f"Table    : {order['table']}")
        print(f"Total    : ₹{order['total']:.2f}")

        print("Items:")

        for item in order["items"]:
            print(
                f"  {item['name']} × {item['quantity']} "
                f"= ₹{item['amount']:.2f}"
            )


# ================= CANCEL ORDER =================

def cancel_order():
    if not orders:
        print("No orders available!")
        return

    order_id = input("Enter Order ID to cancel: ").strip()

    if order_id not in orders:
        print("Order not found!")
        return

    order = orders[order_id]

    print("\n========== ORDER DETAILS ==========")
    print("Order ID :", order_id)
    print("Customer :", order["customer"])
    print("Table    :", order["table"])
    print(f"Total    : ₹{order['total']:.2f}")

    confirm = input(
        "Are you sure you want to cancel this order? (yes/no): "
    ).strip().lower()

    if confirm == "yes":
        del orders[order_id]

        save_data(ORDER_FILE, orders)

        print("\nOrder cancelled successfully!")

    else:
        print("\nOrder cancellation cancelled.")


# ================= DAILY SALES =================

def daily_sales():
    if not orders:
        print("No sales available!")
        return

    total_sales = 0

    for order in orders.values():
        total_sales += order["total"]

    gst_sales = total_sales * 0.05
    grand_sales = total_sales + gst_sales

    print("\n========== SALES REPORT ==========")
    print(f"Total Orders : {len(orders)}")
    print(f"Total Sales  : ₹{total_sales:.2f}")
    print(f"GST (5%)     : ₹{gst_sales:.2f}")
    print(f"Grand Sales  : ₹{grand_sales:.2f}")


# ================= MAIN MENU =================

while True:

    print("\n")
    print("============================================")
    print("       RESTAURANT MANAGEMENT SYSTEM")
    print("============================================")
    print("1. Add Food Item")
    print("2. View Menu")
    print("3. Search Food")
    print("4. Take Customer Order")
    print("5. Generate Bill")
    print("6. View All Orders")
    print("7. Cancel Order")
    print("8. Sales Report")
    print("9. Exit")
    print("============================================")

    try:
        choice = int(input("Enter your choice: "))
    except ValueError:
        print("Please enter a valid number!")
        continue

    if choice == 1:
        add_food()

    elif choice == 2:
        view_menu()

    elif choice == 3:
        search_food()

    elif choice == 4:
        take_order()

    elif choice == 5:
        generate_bill()

    elif choice == 6:
        view_orders()

    elif choice == 7:
        cancel_order()

    elif choice == 8:
        daily_sales()

    elif choice == 9:
        print("Thank you for using Restaurant Management System!")
        break

    else:
        print("Invalid choice!")
